* text=auto
*.mjs text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
# Preserve upstream text byte-for-byte for checksum verification on Windows.
src/assets/** -text
# Test fixtures are identified by SHA-256 pins (slicer profiles, reference 3MF,
# corpus): keep every byte as committed, whatever the platform's line-ending
# policy is (Codex release round 3, R3-C10).
tests/fixtures/** -text
