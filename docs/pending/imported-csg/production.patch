+      }else if(p.mode==AM_AUTO_BODY_HEIGHT){need(id==AM_F_ringH,"AUTO_MODE_UNSUPPORTED",id);need(p.value==0,"AUTO_MODE_REQUIRES_STORED_ZERO",id);val=0;}
