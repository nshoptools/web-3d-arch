+		return this.settings || this.DefaultSettings_;
+
+	}
+
+	/**
+	 * Copies a sample value to the result buffer.
+	 *
+	 * @param {number} index - An index into the sample value buffer.
+	 * @return {TypedArray} The result buffer.
+	 */
+	copySampleValue_( index ) {
