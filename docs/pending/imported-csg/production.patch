+   need(solid.BoundingBox().min.z>=0,"DERIVED_BELOW_MANUFACTURING_BED");
+   world.push_back(solid);groups.push_back(group);
+   auto assembled=solid;
+   if(owner!=UINT32_MAX){
+    const auto*t=g->info[owner].preview_transform;
+    assembled=b.evaluate(solid.Transform(manifold::mat3x4({{t[0],t[1],t[2]},{t[4],t[5],t[6]},{t[8],t[9],t[10]}},{t[12],t[13],t[14]})));
+   }else{
+    // New separate parts belong to bed group2. Welding to a moving assembly
+    // obtains that target's original owner and transform through the CSG result.
+    need(group==2,"DERIVED_IMPORTED_ASSEMBLY_TRANSFORM_REQUIRED");
+   }
+   preview.push_back(assembled);
+   if(g->rot&&group!=2)solid=solid.Rotate(0,0,-g->rot);
+   if(group==1)solid=solid.Translate({-g->secondary_x,0,0});
+   local.push_back({b.evaluate(solid),0,AM_BODY,group,{AM_BODY,p.color_rgba,1,AM_USER,1}});
+  }
+  need(next_vertex==v->vertex_count&&next_triangle==v->triangle_count,"DERIVED_PART_COVERAGE");
+  const double budget=std::min({1e-7,g->scalars.mating_tolerance_mm/1000,g->scalars.export_tolerance_mm/1000});
+  auto empty=[&](const Manifold&m,const char*error){
+   auto raw=b.evaluate(m);need(raw.GetTolerance()<=budget,"DERIVED_GUARD_QUERY_UNVERIFIED");
+   auto q=b.evaluate(raw.AsOriginal().Simplify(budget));need(q.IsEmpty()||q.Volume()==0,error);
+  };
+  for(size_t i=0;i<world.size();i++)for(size_t j=0;j<i;j++){
+   b.checkpoint();empty(world[i]^world[j],"DERIVED_MANUFACTURING_COLLISION");
+   if(groups[i]!=groups[j])empty(preview[i]^preview[j],"DERIVED_ASSEMBLY_COLLISION");
+  }
+  b.verify_cavities(local);
+  if(!b.tunnels.empty()){
+   std::vector<Manifold> host;for(const auto&p:local)if(p.group==0)host.push_back(p.mesh);
+   auto final_host=b.evaluate(Manifold::BatchBoolean(host,manifold::OpType::Add));
+   need(!final_host.IsEmpty(),"DERIVED_HOST_MISSING");
+   const auto bounds=final_host.BoundingBox();
+   b.footprint=final_host.Project();b.body_z=bounds.min.z;b.body_h=bounds.max.z-bounds.min.z;
+   for(auto&t:b.tunnels){
+    for(double x:{bounds.min.x,bounds.max.x})for(double y:{bounds.min.y,bounds.max.y}){
+     const double along=(x-t.cx)*t.dx+(y-t.cy)*t.dy;
+     need(std::abs(along)<t.length/2,"DERIVED_TUNNEL_MOUTH_DOMAIN_UNVERIFIED");
+    }
+    // Later CSG may add material, so the old constructive subtraction proof
+    // does not apply. Check the ENTIRE preserved opening volume explicitly.
+    empty(t.opening^final_host,"DERIVED_TUNNEL_OPENING_OBSTRUCTED");
+    t.cutter=b.evaluate(t.opening^prism(b.footprint,b.body_z,b.body_z+b.body_h));
+   }
+   b.verify_tunnels(local);
+  }
+  // Exact represented-facet certificate, no tolerance or few-ray witness.
+  // A changed triangulation is a typed refusal, not silently accepted by area.
+  std::set<std::tuple<uint32_t,uint32_t,std::array<double,9>>> faces;
+  for(uint32_t pi=0;pi<v->part_count;pi++){
+   const auto&p=v->parts[pi];
+   for(uint32_t t=p.triangle_start;t<p.triangle_start+p.triangle_count;t++){
+    if(t%1024==0)b.checkpoint();
+    faces.emplace(v->groups[pi],p.color_rgba,oriented_face(v->vertices,v->triangles+3*size_t(t)));
+   }
+  }
+  for(const auto&f:g->protected_faces){
+   b.checkpoint();
+   need(faces.count({f.group,f.rgba,f.xyz})!=0,
+    f.source?"DERIVED_SOURCE_DATUM_FACE_UNPROVED":"DERIVED_MECHANICAL_FEATURE_CHANGED",0,AM_UNSUPPORTED);
+  }
+  b.diagnostic(120,0,"POST_CSG_GUARDS: actual final solids; full-volume cavities/openings, full-domain strap roof/floor, manufacturing/assembly collisions and exact original reference facets");
+  b.diagnostic(121,0,"SOURCE_DATUM_SCOPE: original MM/layer/off-grid records retained unchanged; no conversion receipt or global numeric/fit qualification");
+  out->export_blocked=0;b.checkpoint();
+ }catch(const Failure&f){
+  if(!out)return nullptr;out->verdict=f.verdict;ArchMechDiagnostic d{};d.code=f.verdict;d.field_id=f.field;copystr(d.message,f.what());out->diagnostics.push_back(d);
+ }catch(const std::exception&e){
+  if(!out)return nullptr;out->verdict=AM_KERNEL_ERROR;ArchMechDiagnostic d{};d.code=AM_KERNEL_ERROR;copystr(d.message,e.what());out->diagnostics.push_back(d);
+ }catch(...){if(!out)return nullptr;out->verdict=AM_KERNEL_ERROR;}
+ if(out->verdict!=AM_OK)out->export_blocked=1;
+ if(acquired)c->stage.store(out->verdict==AM_OK?6:out->verdict==AM_CANCELLED?8:7);
+ return out.release();
+}
diff --git a/src/kernel/mechanics/src/derived_guard.cpp.inc b/src/kernel/mechanics/src/derived_guard.cpp.inc
new file mode 100644
index 0000000000000000000000000000000000000000..279f4180352fc28b3f2f5060c2fe93c6188fafc9
--- /dev/null
+++ b/src/kernel/mechanics/src/derived_guard.cpp.inc
@@ -0,0 +1,20 @@
+// Included in mechanics.cpp: reuse its actual final-volume/interval guards.
+struct ArchMechGuard {
+ ArchMechRequest scalars{};
+ std::vector<CavityGuard> cavities;
+ std::vector<TunnelGuard> tunnels;
+ CrossSection footprint;
+ double body_z=0,body_h=0,rot=0,secondary_x=0;
+ std::vector<ArchMechPartInfo> info;
+ struct Face {uint32_t part,face,group,rgba;bool source;std::array<double,9> xyz;};
+ std::vector<Face> protected_faces;
+ uint64_t charge=0;
+ uint32_t export_blocked=1;
+};
+static std::array<double,9> oriented_face(const double* xyz,const uint32_t* tri){
+ std::array<std::array<double,3>,3> v;
+ for(int k=0;k<3;k++)for(int a=0;a<3;a++)v[k][a]=xyz[3*size_t(tri[k])+a];
+ int first=0;for(int k=1;k<3;k++)if(v[k]<v[first])first=k;
+ std::array<double,9> out;for(int k=0;k<3;k++)for(int a=0;a<3;a++)out[3*k+a]=v[(first+k)%3][a];
+ return out;
+}
diff --git a/src/kernel/mechanics/src/derived_guard.h b/src/kernel/mechanics/src/derived_guard.h
new file mode 100644
index 0000000000000000000000000000000000000000..f077912926634ad8c94a96c2f0f02416aaded1bd
--- /dev/null
+++ b/src/kernel/mechanics/src/derived_guard.h
@@ -0,0 +1,34 @@
+#pragma once
+#include "mechanics.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+/* Additive trusted native ABI1. Owned guard is taken once from a successful
+ * mechanics result. It retains immutable final feature domains, not a verdict
+ * token. No JavaScript pointer entry and no request/default re-evaluation. */
+typedef struct ArchMechGuard ArchMechGuard;
+typedef struct {
+ uint32_t abi_version,vertex_count,triangle_count,part_count;
+ const double* vertices;
+ const uint32_t* triangles;
+ const ArchMechPart* parts;
+ /* Original generated part index, or UINT32_MAX for an explicitly separate
+  * imported part. Groups for imported parts must be explicitly approved. */
+ const uint32_t* owners;
+ const uint32_t* groups;
+ /* Four u32 per triangle: operand, original part, original face, reversed.
+  * Pinned Manifold ancestry; not exclusive authorship of coincident faces. */
+ const uint32_t* face_origins;
+} ArchMechDerivedView;
+uint32_t arch_mech_derived_guard_version(void);
+ArchMechGuard* arch_mech_guard_take(ArchMechResult*);
+uint64_t arch_mech_guard_charge(const ArchMechGuard*);
+void arch_mech_guard_destroy(ArchMechGuard*);
+/* Synchronous borrowed arrays; result has diagnostics and NO replacement mesh.
+ * The input and original guard are never modified. Cancellation checkpoints
+ * surround bounded library calls; the parent Worker retains its watchdog. */
+ArchMechResult* arch_mech_guard_check(const ArchMechGuard*,
+ const ArchMechDerivedView*,ArchMechControl*,uint32_t generation);
+#ifdef __cplusplus
+}
+#endif
