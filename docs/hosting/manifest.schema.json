{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "web-3d-arch public host manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "buildId", "assets", "navigations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "buildId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,80}$" },
    "assets": {
      "type": "array", "minItems": 1, "maxItems": 65536,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["url", "file", "bytes", "sha256", "mime", "cache"],
        "properties": {
          "url": { "type": "string", "pattern": "^/[A-Za-z0-9_./-]+$", "maxLength": 2048 },
          "file": { "type": "string", "pattern": "^[A-Za-z0-9_./-]+$", "maxLength": 2047 },
          "bytes": { "type": "integer", "minimum": 1, "maximum": 268435456 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "mime": {
            "enum": ["text/html; charset=utf-8", "text/javascript; charset=utf-8", "text/css; charset=utf-8",
              "application/wasm", "font/woff2", "font/woff", "font/ttf", "font/otf",
              "image/png", "image/jpeg", "image/webp", "image/avif", "image/x-icon",
              "application/json; charset=utf-8", "application/manifest+json; charset=utf-8", "application/octet-stream"]
          },
          "cache": { "enum": ["revalidate", "immutable"] }
        }
      }
    },
    "navigations": {
      "type": "object", "minProperties": 1, "maxProperties": 1000,
      "required": ["/"],
      "propertyNames": { "pattern": "^/[A-Za-z0-9_./-]*$" },
      "additionalProperties": { "type": "string" }
    }
  },
  "$comment": "Schema describes wire shape. Runtime additionally enforces canonical paths, forbidden names, no links, exact MIME/extension, SHA/bytes, navigation HTML targets, unique URLs/files, immutable SHA prefix, root and memory limits."
}
